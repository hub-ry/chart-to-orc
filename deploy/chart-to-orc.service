# chart-to-orc: web app + observer, on your server.
# Install: sudo cp deploy/chart-to-orc.service /etc/systemd/system/ && sudo systemctl enable --now chart-to-orc
[Unit]
Description=chart-to-orc: draw charts, run blind agents
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_GROUP
WorkingDirectory=/opt/chart-to-orc
# Adapt paths/user/group before installing. Env file must be private (0600).
EnvironmentFile=/etc/chart-to-orc/env
ExecStart=/opt/chart-to-orc/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787
Environment=ORC_DATA_DIR=/opt/chart-to-orc/data
Restart=always
RestartSec=5

# NoNewPrivileges and private /tmp; docker CLI + loopback NATS still fine.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/chart-to-orc/data

[Install]
WantedBy=multi-user.target
